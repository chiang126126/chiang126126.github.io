# === 交易所 ===
BINANCE_API_KEY=
BINANCE_API_SECRET=

# === 链上数据（GoPlus 免费，无需注册；Moralis 可选）===
GOPLUS_API_KEY=          # 可留空，GoPlus 公开接口无 key 也能用（有限速）
MORALIS_API_KEY=         # 可选，用于获取完整持有人列表（free tier: 40k CU/day）

# === Discord ===
DISCORD_WEBHOOK_URL=     # 信号通知 webhook
DISCORD_ALERT_WEBHOOK=   # 系统告警（风控熔断、API 错误）

# === 运行模式 ===
# paper  : 只记录信号，不下单
# live   : 真实下单（需 BINANCE_API_KEY + SECRET）
RUN_MODE=paper

# === 扫描参数 ===
SCAN_INTERVAL_MINUTES=15       # 扫描间隔
PREFILTER_PRICE_CHANGE_PCT=20  # 预筛：24h 涨幅 >= 20% 才进深度分析
PREFILTER_OI_SPIKE_PCT=30      # 预筛：24h OI 增幅 >= 30% 才进深度分析

# === 风控 ===
MAX_RISK_PER_TRADE_PCT=1.0     # 单笔最大风险（账户净值的 %）
MAX_OPEN_POSITIONS=5
MAX_DAILY_DRAWDOWN_PCT=5.0
MAX_LEVERAGE=3.0               # 最大杠杆，防止强平价在止损价之前触发
