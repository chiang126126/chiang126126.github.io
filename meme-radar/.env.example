# 全部可选。本地跑：export $(grep -v '^#' .env | xargs) && python run.py cycle --verbose
BLOCKSCOUT_API_KEY=            # https://dev.blockscout.com 免费档（5 rps / 10 万次每天）。不填走公共实例
COINGECKO_API_KEY=             # CoinGecko demo key（可选）
LLM_PROVIDER=none              # deepseek / openai / anthropic / none
LLM_API_KEY=
LLM_MODEL=                     # 留空用默认：deepseek-chat / gpt-4o-mini / claude-sonnet-5
LLM_BASE_URL=                  # 自定义兼容端点（可选）
GMGN_API_KEY=                  # 可选
GMGN_BASE_URL=                 # 可选
ROBINHOOD_RPC_URL=             # 留空用官方 https://rpc.mainnet.chain.robinhood.com
RADAR_DATA_DIR=                # 留空用 meme-radar/data
