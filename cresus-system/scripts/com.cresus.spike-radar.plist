<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cresus.spike-radar</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/mangzi/cresus-bot/scripts/spike_radar.py</string>
        <string>refresh</string>
    </array>

    <!-- 每 5 分钟刷新一次,妖币雷达需要更高时效性 -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/mangzi/cresus-bot/logs/spike_radar.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mangzi/cresus-bot/logs/spike_radar.log</string>
</dict>
</plist>
