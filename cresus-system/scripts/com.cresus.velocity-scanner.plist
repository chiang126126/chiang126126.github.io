<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cresus.velocity-scanner</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/mangzi/cresus-bot/scripts/volume_velocity_scanner.py</string>
    </array>

    <!-- 每 60s 扫描一次 (200 标的串行约 16s + buffer) -->
    <key>StartInterval</key>
    <integer>60</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/mangzi/cresus-bot/logs/velocity_scanner.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mangzi/cresus-bot/logs/velocity_scanner.log</string>
</dict>
</plist>
