<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cresus.live-trader</string>

    <!-- Phase 3 live_trader.py: 镜像 paper 决策到 Binance Futures.
         当前: testnet + --live + OBS mode = 真单到 testnet (testnet 钱, 不烧真钱).
         切主网真钱前 3 步: 1) 改 LIVE_OBSERVATION_MODE=False
                          2) 加 --mainnet 这行
                          3) touch ~/.allow-live -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/hong/chiang126126.github.io/cresus-system/scripts/live_trader.py</string>
        <string>--once</string>
        <string>--live</string>
    </array>

    <!-- Phase 4.V (5/25): 5s 轮询 — 缩短 paper 信号到 live 首次检查的延迟.
         Rate limit 测算: ~25 weight/poll × 12 polls/min = 300 weight/min (预算 2400/min, 占用 12.5%). -->
    <key>StartInterval</key>
    <integer>5</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- 凭证从 ~/.cresus-bot/binance_keys.json 自动读取 (load_credentials helper).
         不在 plist 里硬编码 key (即使 plist 是私有的, 也避免事故). -->

    <key>WorkingDirectory</key>
    <string>/Users/hong/chiang126126.github.io</string>

    <key>StandardOutPath</key>
    <string>/Users/hong/cresus-bot/logs/live_trader.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hong/cresus-bot/logs/live_trader.log</string>
</dict>
</plist>
