<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cresus.live-trader</string>

    <!-- Phase 3 live_trader.py: 镜像 paper 决策到 Binance Futures.
         Phase 6.A (2026-06-03) — Mainnet Pilot Mode: env vars 切到主网真钱.
         设计安全: 默认 testnet (此 plist 通过 EnvironmentVariables 覆盖到 mainnet).
         切回 testnet 时 plist 改 EnvironmentVariables 任一 key (或注释整 block) 即可. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/hong/cresus-bot/.venv/bin/python3</string>
        <string>/Users/hong/chiang126126.github.io/cresus-system/scripts/live_trader.py</string>
        <string>--once</string>
        <string>--live</string>
    </array>

    <!-- Phase 6.A (2026-06-03) Mainnet 关键: 通过 EnvironmentVariables 设置切换主网.
         若想切回 testnet, 把这一整 block 注释掉即可 (live_trader.py 默认 testnet).
         读取细节见 live_trader.py:863 `os.environ.get('CRESUS_MODE', 'testnet')`. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>CRESUS_MODE</key>
        <string>mainnet_pilot</string>
        <key>CRESUS_PILOT_CAPITAL</key>
        <string>600</string>
        <key>BINANCE_KEYS_PATH</key>
        <string>/Users/hong/cresus-bot/binance_keys_mainnet.json</string>
    </dict>

    <!-- Phase 6.O (2026-06-18): StartInterval 5→2s + ThrottleInterval 10→2s
         合并把实际 tick cadence 从 ~10s 减到 ~2s.
         数据驱动 (mainnet 16天 audit): 154 笔 paper trail 赚 → live SL 砍, 累计 -$240+.
         主因之一是 5s+ poll 窗口里价格走 1.6% (median), live sl_paper_current 没及时跟上.
         Rate limit 测算: ~25 weight/poll × 30 polls/min = 750 weight/min (预算 2400/min, 占用 31%).
         安全余量充足.
         (历史: Phase 4.V 5/25: 30→5s; 5/24 加 ThrottleInterval=10 防 crash loop) -->
    <key>StartInterval</key>
    <integer>2</integer>

    <key>RunAtLoad</key>
    <true/>

    <!-- Phase 4.R5 (2026-05-24) — KeepAlive only on crash.
         --once 模式正常 exit 0 后由 StartInterval 拉起下一轮.
         但若 main_loop 抛未捕获异常 (exit != 0) 或 SIGKILL, ThrottleInterval 之后重启.
         Phase 6.O (2026-06-18): ThrottleInterval 10→2 跟 StartInterval 一致.
         若发生 crash loop, 2s 重启间隔仍可控 (log 不会过频, 用户能看到).
         保留 KeepAlive 仅 Crashed=true: 正常 exit 0 后还是 StartInterval 控制. -->
    <key>KeepAlive</key>
    <dict>
        <key>Crashed</key>
        <true/>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>2</integer>

    <!-- 凭证从 BINANCE_KEYS_PATH (上面 EnvironmentVariables) 指定的 json 读取.
         不在 plist 里硬编码 key (即使 plist 是私有的, 也避免事故). -->

    <key>WorkingDirectory</key>
    <string>/Users/hong/chiang126126.github.io</string>

    <key>StandardOutPath</key>
    <string>/Users/hong/cresus-bot/logs/live_trader.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/hong/cresus-bot/logs/live_trader.log</string>
</dict>
</plist>
