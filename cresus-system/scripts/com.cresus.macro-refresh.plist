<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cresus.macro-refresh</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/mangzi/cresus-bot/src/risk/macro_calendar.py</string>
        <string>refresh</string>
    </array>

    <!-- 每小时第 5 分钟运行（避开整点拥堵） -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>5</integer></dict>
    </array>

    <!-- 启动时立即跑一次 -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/mangzi/cresus-bot/logs/macro_refresh.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mangzi/cresus-bot/logs/macro_refresh.log</string>
</dict>
</plist>
