# 本地运行用。复制为 .env 后填写。.env 已被 .gitignore，不会进 git。
MODE=testnet                   # dry(只决策) | sim(模拟撮合) | testnet(币安模拟盘真下单)

# 本地跑想让看板也显示：填你 clone 的独立仓库路径（run_local.sh 会自动 pull/push）
# 例：DATA_REPO=/Users/hong/mp-data
DATA_REPO=
# 不用看板、只本地存数据则改用这个（DATA_REPO 留空时生效）
DATA_DIR=./data

# LLM（DeepSeek 便宜，推荐；留空则自动用确定性规则兜底）
LLM_PROVIDER=deepseek          # deepseek | openai
LLM_API_KEY=
LLM_MODEL=deepseek-chat        # openai 用 gpt-4o-mini 等

# 币安现货模拟盘（仅 MODE=testnet 需要，从 testnet.binance.vision 生成）
BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=
