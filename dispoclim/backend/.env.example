# ===== DispoClim backend — variables d'environnement (NE PAS committer le vrai .env) =====

# Serveur
PORT=8080
PUBLIC_BASE_URL=https://api.dispoclim.fr     # base publique de l'API (liens unsubscribe, etc.)
FRONT_ORIGIN=https://chiang126126.github.io  # CORS : origine autorisée du front

# Base de données (PostgreSQL, région UE)
DATABASE_URL=postgres://user:password@host:5432/dispoclim

# Stripe (paiement unique du Pass — mode 'payment', jamais 'subscription')
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PASS_PRICE_CENTS=199

# Brevo (e-mail transactionnel + SMS, UE) — alt : Resend + Twilio/OVH
BREVO_API_KEY=xkeysib-xxx
BREVO_SENDER_EMAIL=alertes@dispoclim.fr
BREVO_SENDER_NAME=DispoClim
BREVO_SMS_SENDER=DispoClim

# Collector
COLLECTOR_USER_AGENT=DispoClimBot/0.1 (+https://dispoclim.fr/bot)
# Connecteurs actifs (csv). 'demo' = données de démonstration. 'awin' = flux affilié réel.
# ex. ENABLED_CONNECTORS=awin   ou   demo,awin
ENABLED_CONNECTORS=demo
# Anti-doublon des notifications (minutes)
NOTIFY_DEDUPE_MINUTES=120

# ===== Connecteur réel : Awin (flux produits d'affiliation) =====
# Clé API "Product Feed" Awin (différente de la clé Publisher API).
AWIN_API_KEY=
AWIN_LANGUAGE=fr
# Identifiant de flux (fid) OU URL complète Create-a-Feed, par annonceur approuvé.
# ManoMano FR = merchant ID Awin 17547 (programme actif).
AWIN_FEED_MANOMANO=
# AWIN_FEED_CASTORAMA=     # merchant ID 6991
# AWIN_FEED_DARTY=         # merchant ID 7735
# EAN des produits suivis (csv) — clé d'appariement prioritaire dans le flux.
EAN_PORTASPLIT_12000=
EAN_COMFEE_9000=
