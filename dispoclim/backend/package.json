{
  "name": "dispoclim-backend",
  "version": "0.1.0",
  "private": true,
  "description": "DispoClim — API, collecteur de stock, paiement et alertes (MVP)",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "collector": "tsx src/collector/run.ts",
    "collector:start": "node dist/collector/run.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:awin": "tsx scripts/test-awin.ts",
    "db:init": "tsx scripts/init-db.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "stripe": "^16.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
